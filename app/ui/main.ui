  <property name="windowTitle">
   <string>MainWindow</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QMainWindow  {
    background-color: #010409;
    color: #c9d1d9;
    font-family: &quot;Segoe UI&quot;, &quot;Helvetica&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 14px;
    outline: none;
}
QLabel[class=&quot;foto-circular&quot;] {
    border: 2px solid #30363d; 
    border-radius: 50px;      
    background-color: #161b22; 
}



QFrame {
   background-color: #010409;
   font-family: &quot;Segoe UI&quot;, &quot;Helvetica&quot;, &quot;Arial&quot;, sans-serif;
   color: #c9d1d9;
    font-size: 14px;
    outline: none;
   
}

QFrame[class=&quot;second-background&quot;]{
   background-color:#0d1117;
}


/*Borde general*/
QFrame[class=&quot;borde-general&quot;]{
border: 2px solid #30363D;
border-radius:10px;
}

/*Label titulo*/
QLabel[class=&quot;label-h1&quot;] {
font: 900 16pt &quot;Segoe UI&quot;;
 color: #E6EDF3;


}

/* Label primario */
QLabel[class=&quot;label-main&quot;] {
    color: #E6EDF3;
    font-size: 14px;
}

/* Label secundario */
QLabel[class=&quot;label-hint-bold&quot;] {
    color: #8B949E;
    font-size: 14px;
   font:bold;
}


/*Nombre de compañia*/
QLabel[class=&quot;text-company&quot;] {
	font: 12pt &quot;Segoe UI&quot;;
    color: #8B949E;
}


/* botones de control*/
QPushButton[class=&quot;button-control&quot;] {
    color: #C9D1D9;
    border: 2px solid #30363D;
    border-radius: 8px;
    padding: 8px;
}

QPushButton[class=&quot;button-control&quot;]:hover {
    background-color: #0D1117;
    border: 2px solid #e2e2e2;
}

QPushButton[class=&quot;button-control&quot;]:pressed {
    border: 2px solid #1F6FEB;
}


/*INPUTS (QLineEdit) */
QLineEdit[class=&quot;main-field&quot;]{
    background-color: #161B22;
    color: #C9D1D9;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #2F81F7;
    selection-color: #FFFFFF;
    font-size: 14px;
}

/* Hover */
QLineEdit[class=&quot;main-field&quot;]:hover {
    border: 1px solid #8B949E;
}

/* Focus */
QLineEdit[class=&quot;main-field&quot;]:focus {
    border: 1px solid #2F81F7;
    background-color: #161B22;
}

/* Disabled */
QLineEdit[class=&quot;main-field&quot;]:disabled {
    background-color: #0D1117;
    color: #6E7681;
    border: 1px solid #21262D;
}

/* =========================
   BOTÓN PRINCIPAL
   ========================= */
QPushButton[class=&quot;main-button&quot;] {
    background-color: #238636;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px;
    font-weight: bold;
    font-size: 15px;

}

/* Hover */
QPushButton[class=&quot;main-button&quot;]:hover {
    background-color: #2EA043;
}

/* Click */
QPushButton[class=&quot;main-button&quot;]:pressed {
    background-color: #1A7F37;
}

/* Disabled */
QPushButton[class=&quot;main-button&quot;]:disabled {
    background-color: #21262D;
    color: #6E7681;
}



/* =========================
   BOTÓN SECUNDARIO
   ========================= */
QPushButton[class=&quot;secondary-button&quot;] {
    background-color: #238636;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px;
    font-weight: bold;
    font-size: 14px;

}

/* Hover */
QPushButton[class=&quot;secondary-button&quot;]:hover {
    background-color: #2EA043;
}

/* Click */
QPushButton[class=&quot;secondary-button&quot;]:pressed {
    background-color: #1A7F37;
}

/* Disabled */
QPushButton[class=&quot;secondary-button&quot;]:disabled {
    background-color: #21262D;
    color: #6E7681;
}



/* =========================
   BOTÓNES REDONDOS
   ========================= */
QPushButton[class=&quot;buttons-circle&quot;] {
    background-color:#010409E;
    color: white;
    border: 2px solid #FFFFFF;
    border-radius: 19px;
    padding: 8px;
    font-weight: bold;
    font-size: 14px;
}

/* Hover */
QPushButton[class=&quot;buttons-circle&quot;]:hover {
    background-color: #30363D;
    

}

/* Click */
QPushButton[class=&quot;buttons-circle&quot;]:pressed {
    background-color: #000000;
}

/* Disabled */
QPushButton[class=&quot;buttons-circle&quot;]:disabled {
    background-color: #010409;
    color: #6E7681;
}


/* =========================
   BOTÓNES 
   ========================= */
QPushButton[class=&quot;buttons&quot;] {
    background-color:#010409;
    color: white;
    border:1px solid #8B949E;
    border-radius: 6px;
    padding: 8px;
    font-weight: bold;
    font-size: 14px;
}

/* Hover */
QPushButton[class=&quot;buttons&quot;]:hover {
    background-color: #30363D;
}

/* Click */
QPushButton[class=&quot;buttons&quot;]:pressed {
    border:1px solid #8B949E;
    background-color: #000000;
}

/* Disabled */
QPushButton[class=&quot;buttons&quot;]:disabled {
    background-color: #010409;
    color: #6E7681;
}



/* =========================
   BOTÓNES MENU
   ========================= */
QPushButton[class=&quot;button-menu&quot;] {
    background-color:#010409;
    color: white;
    border-radius: 6px;
    padding: 8px;
    font-weight: bold;
    font-size: 14px;
}

/* Hover */
QPushButton[class=&quot;button-menu&quot;]:hover {
    background-color: #30363D;
}

/* Click */
QPushButton[class=&quot;button-menu&quot;]:pressed {
    border: 1px  solid #8B949E;
    background-color: #000000;
}

/* Disabled */
QPushButton[class=&quot;button-menu&quot;]:disabled {
    background-color: #010409;
    color: #6E7681;
}




/*LINK*/
QLabel[class=&quot;label-link&quot;] {
    color: #2F81F7;
    text-decoration: underline;
}

QLabel[class=&quot;label-link&quot;]:hover {
    color: #58A6FF;
}

/*Texto error*/
QLabel[class=&quot;label-error&quot;]{
color:#F85149;
font-size: 14px;
}

/*Texto éxito*/
QLabel[class=&quot;label-success&quot;]{
color:#238636;
font-size: 14px;
}

/*borde arriba */
QFrame[class=&quot;border-top&quot;] {
    border-top: 1px solid #8B949E;
    border-bottom: 0px;
    border-left: 0px;
    border-right: 0px;
}

/*LABEL LOGO */
QLabel[class=&quot;label-logo&quot;]{
font: 700 20pt &quot;Script MT&quot;;
color: #E7E5E4;
}</string>
